# Copy to .env.local (development) and fill in. NEVER commit real values. `.env*` is git-ignored.
# Validated at server start by src/lib/env.ts (a bad/missing value stops the app with a readable message).

# --- Database (Neon Postgres). SECRET -------------------------------------------------------
# Pooled connection used at runtime (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection used for migrations (same host WITHOUT "-pooler").
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Secrets. SECRET, at least 32 characters each -------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

# --- Login (Step 6). SECRET ----------------------------------------------------------------
# Create with `pnpm hash-password`. Wrap in SINGLE quotes locally ($ characters!). Required in production.
# APP_PASSWORD_HASH='$2b$12$...'

# --- Public (safe to expose to the browser) --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Ingest CORS allow-list (comma-separated origins, https; http only for localhost) ---------
INGEST_ALLOWED_ORIGINS=https://predigoal.com

# --- Optional: licensed/official data API (mode A) only -------------------------------------
# PROVIDER_API_BASE=
# PROVIDER_API_KEY=

# --- Optional ----------------------------------------------------------------------------------
# LOG_LEVEL=info

# --- Tests only (.env.test.local) ---------------------------------------------------------------
# DATABASE_URL_TEST / DIRECT_URL_TEST: an isolated test database or schema. NEVER your dev or production data.
# DATABASE_URL_TEST=
# DIRECT_URL_TEST=

# Step 6: plaintext password used ONLY by Playwright to sign in (git-ignored .env.test.local); its hash goes in APP_PASSWORD_HASH
# E2E_PASSWORD=
