# Copy to .env.local and fill in. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=<generate-me>
CRON_SECRET=<generate-me>
# bcrypt hash from `pnpm hash-password`, single-quoted
APP_PASSWORD_HASH='<bcrypt-hash>'
NEXT_PUBLIC_APP_URL=http://localhost:3000
INGEST_ALLOWED_ORIGINS=https://predigoal.com
# Mode A only
PROVIDER_API_BASE=
PROVIDER_API_KEY=
LOG_LEVEL=info
# Tests only (.env.test.local): isolated schema, e.g. ...?schema=test
DATABASE_URL_TEST=
DIRECT_URL_TEST=
E2E_PASSWORD=
